APP_NAME="LarvelC Chat"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Tehran
APP_URL=https://chat.example.com
TRUSTED_HOSTS=chat.example.com
TRUSTED_PROXIES=REMOTE_ADDR

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=LarvelC
DB_USERNAME=LarvelC
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=true
SESSION_SERIALIZATION=json
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

CHAT_HISTORY_LIMIT=50
CHAT_HISTORY_TTL_MINUTES=30
CHAT_DOM_MESSAGE_LIMIT=300
CHAT_HEARTBEAT_SECONDS=180
CHAT_GUEST_STALE_HOURS=24

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=chat.example.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=https://chat.example.com
REVERB_APP_MAX_MESSAGE_SIZE=10000

HEALTH_CHECK_REVERB=true
HEALTH_REVERB_HOST=127.0.0.1
HEALTH_REVERB_PORT=8080
HEALTH_SOCKET_TIMEOUT=0.5

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
